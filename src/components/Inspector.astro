---
// One line to step through by hand on a grey wedge, or to play.
import "./Inspector.scss";

const steps = ["#fff", "#ececec", "#d6d6d6", "#bdbdbd", "#a3a3a3", "#888"];
const wedge = [...steps, "#6d6d6d", "#535353", "#3a3a3a", "#242424", "#111"];
---

<section class="inspector" aria-label="Inspector">
  <p class="big" id="specimen">
    Ink settles into type.
  </p>
  <div class="inspector-wedge">
    <label for="scrub">Step through one reveal</label>
    <button type="button" class="inspector-play" id="play">
      Play
    </button>
    <div class="inspector-track">
      <span class="inspector-steps" aria-hidden="true">
        {wedge.map((grey) => (
          <i style={{ background: grey }} />
        ))}
      </span>
      <input type="range" id="scrub" min="0" max="1" step="0.001" value="1" />
    </div>
    <span class="inspector-scale mono" aria-hidden="true">
      {[0, 25, 50, 75, 100].map((n) => (
        <span>{n}</span>
      ))}
    </span>
  </div>
</section>
